# Vimbrowser is a Linux/macOS CEF product. Keep the root graph deliberately
# limited to the shipping CEF library instead of loading Chromium's standalone
# browser, platform products, tests, benchmarks, and packaging tools.
assert(is_linux || is_mac, "vimbrowser supports only Linux and macOS")

group("vimbrowser") {
  if (is_mac) {
    deps = [ "//cef:cef_framework" ]
  } else {
    deps = [ "//cef:libcef" ]
  }
}
