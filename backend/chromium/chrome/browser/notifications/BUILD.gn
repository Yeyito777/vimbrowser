# Vimbrowser deliberately has no browser notification presentation backend.
# These targets retain only the interfaces and no-op compatibility services
# needed by shared Chrome, push-messaging, and service-worker code.
source_set("notifications") {
  public_deps = [
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//url",
  ]

  sources = [
    "notification_common.h",
    "notification_display_service.h",
    "notification_display_service_factory.h",
    "notification_handler.h",
  ]
}

source_set("system_notification_helper") {
  sources = [ "system_notification_helper.h" ]

  public_deps = [ "//ui/message_center/public/cpp" ]
}

source_set("system_notification_helper_impl") {
  sources = [ "system_notification_helper.cc" ]

  deps = [
    ":system_notification_helper",
    "//chrome/browser:browser_public_dependencies",
    "//ui/message_center/public/cpp",
  ]
}
