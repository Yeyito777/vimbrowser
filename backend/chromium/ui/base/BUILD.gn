  if (is_chromeos || ozone_platform_wayland) {
    deps += [ "//ui/base/wayland:unittests" ]
  }

  if (use_glib) {
    sources += [ "glib/scoped_gsignal_unittest.cc" ]
    deps += [ "//ui/base/glib" ]
  }

  if (is_linux && use_dbus) {
