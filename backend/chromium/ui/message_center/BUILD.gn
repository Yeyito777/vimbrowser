# Vimbrowser does not ship a notification center. Keep a null implementation so
# shared Chromium code can retain the narrow process-global interface, and keep
# the public notification value types as a separate compatibility layer.
component("message_center") {
  sources = [
    "dummy_message_center.cc",
    "message_center.h",
    "message_center_export.h",
  ]

  public_deps = [ "//ui/message_center/public/cpp" ]
  defines = [ "MESSAGE_CENTER_IMPLEMENTATION" ]
}

# Preserve the label expected by optional upstream test targets without pulling
# any notification UI test implementation into the production graph.
group("test_support") {
  testonly = true
  deps = [
    ":message_center",
    "//ui/message_center/public/cpp",
  ]
}
