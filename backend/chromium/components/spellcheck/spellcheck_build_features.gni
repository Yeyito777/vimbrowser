# Spellcheck is intentionally excluded from vimbrowser on every supported
# platform. Keep these variables as a thin buildflag skeleton for shared Chrome
# code while disconnecting all spellcheck implementations.
enable_spellcheck = false
use_browser_spellchecker = false
use_renderer_spellchecker = false
enable_spelling_service = false
has_spellcheck_panel = false
