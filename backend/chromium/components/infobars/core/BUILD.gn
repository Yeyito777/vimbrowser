import("//build/config/chrome_build.gni")
import("//build/config/ui.gni")

static_library("core") {
  sources = [
    "confirm_infobar_delegate.cc",
    "confirm_infobar_delegate.h",
    "features.cc",
    "features.h",
    "infobar.cc",
    "infobar.h",
    "infobar_container.cc",
    "infobar_container.h",
    "infobar_container_with_priority.cc",
    "infobar_container_with_priority.h",
    "infobar_delegate.cc",
    "infobar_delegate.h",
    "infobar_manager.cc",
    "infobar_manager.h",
    "simple_alert_infobar_delegate.cc",
    "simple_alert_infobar_delegate.h",
  ]

  if (is_chrome_for_testing) {
    sources += [ "infobars_switches.h" ]
  }

  public_deps = [
    "//base",
    "//build:branding_buildflags",
    "//skia",
    "//ui/base",
  ]

  deps = [
    "//ui/gfx",
    "//ui/gfx/animation",
    "//ui/strings",
    "//url",
  ]

  if (use_aura || !is_ios) {
    deps += [ "//ui/native_theme" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "infobar_container_unittest.cc",
    "infobar_container_with_priority_unittest.cc",
  ]

  deps = [
    ":core",
    "//base",
    "//base/test:test_support",
    "//url",
  ]
}
