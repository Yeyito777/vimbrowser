source_set("common") {
  sources = [
    "input_state.cc",
    "input_state.h",
    "logger.cc",
    "logger.h",
    "omnibox_feature_configs.cc",
    "omnibox_feature_configs.h",
    "omnibox_features.cc",
    "omnibox_features.h",
    "omnibox_focus_state.h",
    "omnibox_metrics_utils.cc",
    "omnibox_metrics_utils.h",
    "string_cleaning.cc",
    "string_cleaning.h",
    "zero_suggest_cache_service_interface.cc",
    "zero_suggest_cache_service_interface.h",
  ]
  deps = [
    "//base",
    "//base:i18n",
    "//components/url_formatter",
    "//ui/base:features",
    "//url",
  ]

  public_deps = [ "//third_party/omnibox_proto" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "string_cleaning_unittest.cc" ]
  deps = [
    ":common",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
