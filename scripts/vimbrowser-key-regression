RUN_ID = 0


def run(cmd: list[str], *, env: dict[str, str] | None = None, timeout: float = 30) -> str:
    proc = subprocess.run(
        cmd,
        cwd=REPO,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"command failed ({proc.returncode}): {' '.join(cmd)}\n"
            f"stdout:\n{proc.stdout}\nstderr:\n{proc.stderr}"
        )
    return proc.stdout


class StaticHttpsServer:
    def __init__(self, html: str, host: str = "not.youtube.com"):
        self.html = html
        self.host = host
        self.root = Path(tempfile.mkdtemp(prefix="vb-key-regression-https-"))
        self.httpd: http.server.ThreadingHTTPServer | None = None
        self.thread: threading.Thread | None = None
        self.url: str | None = None

    def __enter__(self) -> "StaticHttpsServer":
        cert = self.root / "cert.pem"
        key = self.root / "key.pem"
        run([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-days", "1",
            "-subj", f"/CN={self.host}",
            "-addext", f"subjectAltName=DNS:{self.host}",
        ], timeout=20)

        html = self.html.encode()

        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self) -> None:
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(html)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(html)

            def log_message(self, format: str, *args) -> None:  # noqa: A002
                return

        self.httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(certfile=cert, keyfile=key)
        self.httpd.socket = context.wrap_socket(self.httpd.socket, server_side=True)
        port = self.httpd.server_address[1]
        self.url = f"https://{self.host}:{port}/watch?v=regression"
        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
        self.thread.start()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        if self.httpd:
            self.httpd.shutdown()
            self.httpd.server_close()
        shutil.rmtree(self.root, ignore_errors=True)


class SlowReloadHttpServer:
    def __init__(self, document_delay: float = 0.5, resource_delay: float = 2.0):
        self.document_delay = document_delay
        self.resource_delay = resource_delay
        self.request_count = 0
        self.lock = threading.Lock()
        self.httpd: http.server.ThreadingHTTPServer | None = None
        self.thread: threading.Thread | None = None
        self.url: str | None = None

    def __enter__(self) -> "SlowReloadHttpServer":
        outer = self

        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self) -> None:
                if self.path.startswith("/slow-resource"):
                    time.sleep(outer.resource_delay)
                    body = b"<svg xmlns='http://www.w3.org/2000/svg' width='1' height='1'/>"
                    self.send_response(200)
                    self.send_header("Content-Type", "image/svg+xml")
                    self.send_header("Content-Length", str(len(body)))
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if self.path not in ("/", "/index.html"):
                    self.send_response(404)
                    self.end_headers()
                    return
                with outer.lock:
                    outer.request_count += 1
                    generation = outer.request_count
                if generation > 1:
                    # Leave a deterministic window where the old document is still
                    # visible while its replacement navigation is pending.
                    time.sleep(outer.document_delay)
                slow_resource = (
                    f'<img src="/slow-resource?generation={generation}" '
                    'alt="" style="display:none">'
                    if generation > 1 else ""
                )
                html = (RELOAD_HINT_TEST_HTML
                        .replace("__GEN__", str(generation))
                        .replace("__SLOW_RESOURCE__", slow_resource)
                        .encode())
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(html)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(html)

            def log_message(self, format: str, *args) -> None:  # noqa: A002
                return

        self.httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        port = self.httpd.server_address[1]
        self.url = f"http://127.0.0.1:{port}/"
        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
        self.thread.start()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        if self.httpd:
            self.httpd.shutdown()
            self.httpd.server_close()


class StaticHttpMediaServer:
    def __init__(self):
        self.root = Path(tempfile.mkdtemp(prefix="vb-key-regression-media-"))
        self.httpd: http.server.ThreadingHTTPServer | None = None
        self.thread: threading.Thread | None = None
        self.url: str | None = None

    def __enter__(self) -> "StaticHttpMediaServer":
        media = self.root / "test.mp4"
        run([
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-f", "lavfi", "-i", "testsrc2=size=96x96:rate=24",
            "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000",
            "-t", "1",
            "-pix_fmt", "yuv420p",
            "-c:v", "libx264", "-profile:v", "baseline", "-level", "3.0",
            "-c:a", "aac",
            "-movflags", "+faststart",
            str(media),
        ], timeout=30)
        (self.root / "index.html").write_text(MP4_PLAYBACK_TEST_HTML)
        root = self.root

        class Handler(http.server.SimpleHTTPRequestHandler):
            def __init__(self, *args, **kwargs):
                super().__init__(*args, directory=str(root), **kwargs)

            def log_message(self, format: str, *args) -> None:  # noqa: A002
                return

        self.httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        port = self.httpd.server_address[1]
        self.url = f"http://127.0.0.1:{port}/index.html"
        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
        self.thread.start()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        if self.httpd:
            self.httpd.shutdown()
            self.httpd.server_close()
        shutil.rmtree(self.root, ignore_errors=True)


class Harness:
    def __init__(self, binary: Path, *, initial_url: str | None = None,
                 html: str = TEST_HTML, extra_browser_args: list[str] | None = None):
        self.binary = binary.resolve()
        self.profile = Path(tempfile.mkdtemp(prefix="vb-key-regression-profile-"))
        self.page = self.profile / "key_regression.html"
        self.page.write_text(html)
        self.initial_url = initial_url or f"file://{self.page}"
        self.extra_browser_args = extra_browser_args or []
        self.env_name = f"vb-key-regression-{os.getpid()}-{time.monotonic_ns()}"
        self.env = os.environ.copy()
        self.env["VIMBROWSER_PROFILE_DIR"] = str(self.profile)
        self.tab_id: str | None = None

    def cleanup(self) -> None:
        subprocess.run(["xenv", "stop", self.env_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.rmtree(self.profile, ignore_errors=True)

    def __enter__(self) -> "Harness":
        if not self.binary.exists():
            raise RuntimeError(f"binary not found: {self.binary}")
        run(["xenv", "start", self.env_name], timeout=30)
        script = (
            f'cd "{self.binary.parent}" && '
            f'exec "{SAFE_RUN}" ./"{self.binary.name}" '
            f'--profile-dir={shlex.quote(str(self.profile))} '
            f'{" ".join(shlex.quote(arg) for arg in self.extra_browser_args)} '
            f'{shlex.quote(self.initial_url)}'
        )
        subprocess.Popen(
            ["xenv", "run", "-e", self.env_name, "bash", "-lc", script],
            cwd=REPO,
            env=self.env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.tab_id = self.wait_for_tab()
        self.wait_for_ready()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        self.cleanup()

    def ipc(self, args: list[str], timeout: float = 10) -> dict:
        return json.loads(run([str(IPC), *args], env=self.env, timeout=timeout))

    def wait_for_tab(self) -> str:
        deadline = time.time() + 30
        last = None
        while time.time() < deadline:
            try:
                status = self.ipc(["status"], timeout=2)
                tab = status.get("active_tabid")
                if tab:
                    return str(tab)
            except Exception as exc:  # Browser may still be starting.
                last = exc
            time.sleep(0.05)
        raise RuntimeError(f"browser IPC did not become ready; last={last!r}")

    def js(self, expr: str, timeout: float = 10):
        if self.tab_id is None:
            raise RuntimeError("tab is not ready")
        outer = self.ipc(["js", self.tab_id, expr], timeout=timeout)
        result = outer.get("result")
        try:
            return json.loads(result)
        except Exception:
            return result

    def wait_for_ready(self) -> None:
        deadline = time.time() + 15
        while time.time() < deadline:
            try:
                ready = self.js("JSON.stringify({ready:document.readyState})")
                if ready.get("ready") == "complete":
                    return
            except Exception:
                pass
            time.sleep(0.05)
        raise RuntimeError("page did not reach readyState=complete")

    def wait_for_mode(self, mode: str, timeout: float = 3) -> dict:
        deadline = time.time() + timeout
        last = None
        while time.time() < deadline:
            last = self.ipc(["status"])
            if last.get("mode") == mode:
                return last
            time.sleep(0.05)
        raise AssertionError(
            f"browser mode did not become {mode!r}\n{json.dumps(last, indent=2)}")

    def key(self, *keys: str, pause: float = 0.15) -> None:
        run(["xenv", "key", "-e", self.env_name, *keys], timeout=10)
        time.sleep(pause)

    def reset(self, *, focus_input: bool = True) -> None:
        global RUN_ID
        RUN_ID += 1
        self.js(f"window.location.hash='case{RUN_ID}'; window.resetProbe({str(focus_input).lower()})")
        time.sleep(0.05)

    def clear(self) -> None:
        self.js("window.clearProbe()")
        time.sleep(0.05)

    def snapshot(self) -> dict:
        return self.js("JSON.stringify(window.snapshotProbe())")

    def focus_sidebar(self) -> None:
        # First Ctrl+M hides the initially visible sidebar while keeping webview
        # focus; second Ctrl+M shows it again and focuses the sidebar.
        self.key("ctrl+m", "ctrl+m", pause=0.25)


def require(condition: bool, message: str, details=None) -> None:
    if not condition:
        raise AssertionError(f"{message}\n{json.dumps(details, indent=2)}")


def reset_to_website_mode(h: Harness, *, focus_input: bool) -> dict:
    h.reset(focus_input=focus_input)
    if focus_input:
        # Focusing a text field now intentionally auto-enters insert mode.  Wait
        # for that signal so Escape/Escape reliably returns to website mode while
        # preserving the focused input for tests that verify website-mode keys.
        try:
            h.wait_for_mode("INSERT", timeout=2)
        except AssertionError:
            pass
    status = h.ipc(["status"])
    if status.get("mode") == "INSERT":
        h.key("Escape", "Escape", pause=0.25)
    elif status.get("mode") in ("NORMAL", "VISUAL"):
        h.key("Escape", pause=0.2)
    status = h.ipc(["status"])
    require(status.get("mode") == "WEBSITE",
            "could not reset browser to website mode", status)
    return status


def test_mode_entry_i_does_not_leak_and_insert_types(h: Harness) -> None:
    h.reset(focus_input=True)
    h.wait_for_mode("INSERT")
    h.key("Escape", pause=0.2)
    h.wait_for_mode("NORMAL")
    h.clear()
    h.key("i", pause=0.2)
    after_i = h.snapshot()
    require(after_i["value"] == "", "mode-entry i typed into focused input", after_i)
    require(not any(e.get("type") == "input" for e in after_i["events"]),
            "mode-entry i generated an input event", after_i)

    h.key("x", pause=0.2)
    after_x = h.snapshot()
    require(after_x["value"] == "x", "insert mode did not forward following text key", after_x)


def test_text_input_focus_auto_enters_insert_mode(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=False)
    h.clear()
    h.js("document.getElementById('input').focus(); 'ok'")
    status = h.wait_for_mode("INSERT")
    focused = h.snapshot()
    require(focused["active"] == "input",
            "programmatic input focus did not focus the input",
            {"status": status, "snapshot": focused})

    h.clear()
    h.key("x", pause=0.2)
    typed = h.snapshot()
    require(typed["value"] == "x",
            "focused input did not receive typing without pressing i", typed)


def test_hint_to_text_input_auto_enters_insert_mode(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=False)
    h.clear()
    h.key("f", pause=0.25)
    # The body has tabindex=0 for focus tests and receives the first hint label;
    # the text input is the next click-hint target on this fixture.
    h.key("s", pause=0.5)
    status = h.wait_for_mode("INSERT")
    focused = h.snapshot()
    require(focused["active"] == "input",
            "hint selection did not focus the input",
            {"status": status, "snapshot": focused})

    h.clear()
    h.key("z", pause=0.2)
    typed = h.snapshot()
    require(typed["value"] == "z",
            "hint-focused input did not receive typing without pressing i", typed)


def test_first_i_and_shift_i_type_in_insert_mode(h: Harness) -> None:
    h.reset(focus_input=True)
    h.wait_for_mode("INSERT")
    h.clear()
    h.key("i", pause=0.2)
    lower = h.snapshot()
    require(lower["value"] == "i",
            "first insert-mode 'i' keypress was swallowed", lower)

    h.key("Escape", "Escape", pause=0.25)
    h.reset(focus_input=False)
    h.reset(focus_input=True)
    h.wait_for_mode("INSERT")
    h.clear()
    h.key("shift+i", pause=0.2)
    upper = h.snapshot()
    require(upper["value"] == "I",
            "first insert-mode 'I' keypress was swallowed", upper)


def test_shifted_jk_type_in_insert_mode(h: Harness) -> None:
    h.reset(focus_input=True)
    h.wait_for_mode("INSERT")
    h.clear()
    h.key("shift+j", pause=0.15)
    h.key("shift+k", pause=0.2)
    snap = h.snapshot()
    require(snap["value"] == "JK", "Shift+J/K did not type capital letters in insert mode", snap)
    require("J" in snap["keys"] and "K" in snap["keys"],
            "Shift+J/K did not reach the page as keydown events", snap)


def test_insert_escape_exits_without_passthrough(h: Harness) -> None:
    h.reset(focus_input=True)
    h.wait_for_mode("INSERT")
    h.clear()
    h.key("a", pause=0.15)
    h.key("Escape", pause=0.2)
    h.key("j", pause=0.25)
    snap = h.snapshot()
    require(snap["value"] == "a", "insert Escape did not exit before normal-mode j", snap)
    require("Escape" not in snap["keys"], "insert-mode Escape leaked to the page", snap)
    require(snap["scrollY"] > 0, "normal-mode j did not scroll after insert Escape", snap)


def test_normal_escape_returns_to_website_mode(h: Harness) -> None:
    h.reset(focus_input=True)
    h.wait_for_mode("INSERT")
    h.key("Escape", "Escape", pause=0.25)
    initial_status = h.ipc(["status"])
    require(initial_status.get("mode") == "WEBSITE",
            "initial web mode was not website mode", initial_status)

    h.key("i", pause=0.2)
    insert_status = h.ipc(["status"])
    require(insert_status.get("mode") == "INSERT",
            "website-normal i did not enter insert mode", insert_status)

    h.key("Escape", pause=0.2)
    normal_status = h.ipc(["status"])
    require(normal_status.get("mode") == "NORMAL",
            "insert Escape did not enter regular normal mode", normal_status)

    h.clear()
    h.key("Escape", pause=0.2)
    website_status = h.ipc(["status"])
    snap = h.snapshot()
    require(website_status.get("mode") == "WEBSITE",
            "normal-mode Escape did not return to website mode",
            {"status": website_status, "snapshot": snap})
    require(not any(e.get("type") == "keydown" and e.get("key") == "Escape"
                    for e in snap["events"]),
            "normal-mode Escape leaked to the page while switching modes", snap)


def test_website_keybinds_do_not_type(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("j", pause=0.2)
    after_j = h.snapshot()
    require(after_j["scrollY"] > 0, "website-mode j did not scroll page", after_j)

    h.key("k", "m", pause=0.3)
    snap = h.snapshot()
    require(snap["value"] == "", "website-mode keybindings leaked into focused input", snap)
    require(not any(e.get("type") == "input" for e in snap["events"]),
            "website-mode keybindings generated input events", snap)


def test_sidebar_jk_moves_selection_and_enter_activates(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url])
    h.ipc(["open-tab", h.initial_url])
    tabs = h.ipc(["tabs"])["tabs"]
    h.ipc(["tab-focus", str(tabs[0]["id"])])
    h.reset(focus_input=False)
    h.focus_sidebar()
    before = h.ipc(["status"])
    require(before.get("mode") == "SIDEBAR" and before.get("active_index") == 0,
            "could not focus sidebar with first tab selected", before)

    h.key("j", pause=0.25)
    after_j = h.ipc(["status"])
    require(after_j.get("active_index") == 0 and
            after_j.get("sidebar_selected_type") == "tab" and
            after_j.get("sidebar_selected_id") == tabs[1]["id"],
            "sidebar j did not move selection down without activating", after_j)

    h.key("Return", pause=0.25)
    after_enter = h.ipc(["status"])
    require(after_enter.get("active_index") == 1,
            "sidebar Enter did not activate the selected tab", after_enter)

    h.key("k", pause=0.25)
    after_k = h.ipc(["status"])
    require(after_k.get("active_index") == 1 and
            after_k.get("sidebar_selected_id") == tabs[0]["id"],
            "sidebar k did not move selection up without activating", after_k)


def test_sidebar_gg_and_G_jump_to_visible_ends(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url])
    h.ipc(["open-tab", h.initial_url])
    tabs = h.ipc(["tabs"])["tabs"]
    h.ipc(["tab-focus", str(tabs[1]["id"])])
    h.reset(focus_input=False)
    h.focus_sidebar()
    before = h.ipc(["status"])
    require(before.get("mode") == "SIDEBAR" and before.get("active_index") == 1,
            "could not focus sidebar with middle tab selected", before)

    active_id = before.get("active_tabid")
    first_id = tabs[0]["id"]
    last_id = tabs[-1]["id"]

    h.key("g", "g", pause=0.25)
    after_gg = h.ipc(["status"])
    require(after_gg.get("mode") == "SIDEBAR" and
            after_gg.get("active_tabid") == active_id and
            after_gg.get("sidebar_selected_id") == first_id,
            "sidebar gg did not move selection to the first visible entry", after_gg)

    h.key("shift+g", pause=0.25)
    after_G = h.ipc(["status"])
    require(after_G.get("mode") == "SIDEBAR" and
            after_G.get("active_tabid") == active_id and
            after_G.get("sidebar_selected_id") == last_id,
            "sidebar G did not move selection to the last visible entry", after_G)


def test_sidebar_super_is_a_noop(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url + "#super-second"])
    h.ipc(["open-tab", h.initial_url + "#super-third"])
    tabs = h.ipc(["tabs"])["tabs"]
    first, middle = tabs[0], tabs[1]
    h.ipc(["tab-focus", str(middle["id"])])
    h.ipc(["sidebar-focus", "sidebar"])

    # A modifier's own keydown may not carry its modifier flag. VKEY_LWIN is
    # numerically 0x5b (ASCII '['), so it used to run the sidebar '[' binding
    # and also interrupt pending multi-key commands. Keep both Super keys inert:
    # the second g must still complete the gg that began before the modifier.
    for key in ("Super_L", "Super_R"):
        h.ipc(["sidebar-select", "tab", str(middle["id"])])
        before = h.ipc(["status"])
        h.key("g", key, "g", pause=0.3)
        after = h.ipc(["status"])
        require(after.get("mode") == "SIDEBAR" and
                after.get("active_tabid") == before.get("active_tabid") and
                after.get("sidebar_selected_type") == "tab" and
                after.get("sidebar_selected_id") == first["id"],
                f"standalone {key} changed or interrupted sidebar input",
                {"before": before, "after": after})


def test_sidebar_t_opens_tab_focus_command(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url])
    tabs = h.ipc(["tabs"])["tabs"]
    require(len(tabs) >= 2, "sidebar t regression requires at least two tabs", tabs)
    target_id = str(tabs[0]["id"])
    h.ipc(["tab-focus", str(tabs[-1]["id"])])
    h.ipc(["sidebar-focus", "sidebar"])

    h.key("t", pause=0.2)
    command_mode = h.ipc(["status"])
    require(command_mode.get("mode") == "CMD-I",
            "sidebar t did not open the tab-focus command line", command_mode)

    h.key(*target_id, "Return", pause=0.3)
    after_commit = h.ipc(["status"])
    require(str(after_commit.get("active_tabid")) == target_id,
            "sidebar t command was not prefilled with :tab-focus ", after_commit)


def test_sidebar_ctrl_scroll_keys_are_cursor_aware(h: Harness) -> None:
    initial_sidebar = h.ipc(["sidebar"])
    viewport_rows = int(initial_sidebar.get("viewport_rows") or 0)
    require(viewport_rows >= 4,
            "sidebar viewport is too short for Ctrl-scroll regression",
            initial_sidebar)

    # Folders exercise the real sidebar row model without creating dozens of
    # renderer processes merely to overflow the viewport.
    for index in range(viewport_rows * 2 + 8):
        h.ipc(["folder-create", "0", f"scroll-regression-{index:03d}"])

    sidebar = h.ipc(["sidebar"])
    entries = [row for row in sidebar["rows"] if row["kind"] == "entry"]
    require(len(entries) > viewport_rows,
            "sidebar Ctrl-scroll fixture did not overflow the viewport",
            sidebar)

    def select_entry(index: int) -> None:
        row = entries[index]
        h.ipc(["sidebar-select", row["item_type"], str(row["item_id"])])

    def assert_sidebar(expected_index: int, expected_offset: int,
                       message: str) -> None:
        current = h.ipc(["sidebar"])
        expected = entries[expected_index]
        require(current.get("selected_type") == expected["item_type"] and
                current.get("selected_id") == expected["item_id"] and
                current.get("scroll_offset") == expected_offset,
                message,
                {"expected": expected,
                 "expected_offset": expected_offset,
                 "actual": current})

    select_entry(0)
    h.ipc(["sidebar-focus", "sidebar"])
    active_tab = h.ipc(["status"])["active_tabid"]

    # Ctrl+E scrolls the viewport one row and only moves the cursor when its old
    # row would leave the viewport. Ctrl+Y reverses the viewport movement while
    # leaving that now-visible cursor on the same buffer row.
    h.key("ctrl+e", pause=0.2)
    assert_sidebar(1, 1, "sidebar Ctrl+E was not sticky-cursor line scrolling")
    h.key("ctrl+y", pause=0.2)
    assert_sidebar(1, 0, "sidebar Ctrl+Y did not preserve the visible cursor row")

    half_page = viewport_rows // 2
    select_entry(0)
    h.key("ctrl+d", pause=0.2)
    assert_sidebar(half_page, half_page,
                   "sidebar Ctrl+D did not move cursor and viewport by half a page")
    h.key("ctrl+u", pause=0.2)
    assert_sidebar(0, 0,
                   "sidebar Ctrl+U did not reverse the half-page movement")

    page = viewport_rows - 2
    select_entry(0)
    h.key("ctrl+f", pause=0.2)
    assert_sidebar(page, page,
                   "sidebar Ctrl+F did not place the cursor at the new page top")
    h.key("ctrl+b", pause=0.2)
    assert_sidebar(viewport_rows - 1, 0,
                   "sidebar Ctrl+B did not place the cursor at the new page bottom")

    # Section labels and separators are display chrome, not cursor-bearing
    # rows. Drive one-line scrolling directly across the pinned/unpinned split
    # and verify that both the viewport and selection skip the separator.
    pinnable = [row for row in entries if row["item_type"] == "folder"][:3]
    for row in pinnable:
        h.ipc(["folder-pin", str(row["item_id"]), "on"])
    divided = h.ipc(["sidebar"])["rows"]
    last_pinned_index = max(
        index for index, row in enumerate(divided)
        if row["kind"] == "entry" and row.get("pinned"))
    separator_index = next(
        index for index, row in enumerate(divided)
        if row["kind"] == "separator")
    first_unpinned_index = next(
        index for index in range(separator_index + 1, len(divided))
        if divided[index]["kind"] == "entry")
    first_pinned = next(
        row for row in divided
        if row["kind"] == "entry" and row.get("pinned"))
    h.ipc(["sidebar-select", first_pinned["item_type"],
           str(first_pinned["item_id"])])
    h.key("ctrl+y", pause=0.1)
    last_pinned = divided[last_pinned_index]
    h.ipc(["sidebar-select", last_pinned["item_type"],
           str(last_pinned["item_id"])])
    for _ in range(separator_index):
        h.key("ctrl+e", pause=0.05)
    crossed = h.ipc(["sidebar"])
    first_unpinned = divided[first_unpinned_index]
    require(crossed.get("selected_type") == first_unpinned["item_type"] and
            crossed.get("selected_id") == first_unpinned["item_id"] and
            crossed.get("scroll_offset") == first_unpinned_index,
            "sidebar Ctrl+E landed on pinned-section display chrome",
            crossed)
    h.key("ctrl+y", pause=0.2)
    reversed_split = h.ipc(["sidebar"])
    require(reversed_split.get("selected_type") == first_unpinned["item_type"] and
            reversed_split.get("selected_id") == first_unpinned["item_id"] and
            reversed_split.get("scroll_offset") == last_pinned_index,
            "sidebar Ctrl+Y did not skip the pinned-section separator",
            reversed_split)

    # When preserving a cursor near the viewport bottom, Exocortex can
    # intentionally leave the separator itself at the viewport top. A later
    # ordinary refresh must clamp visibility only, not re-snap and shift it.
    h.key("ctrl+e", pause=0.1)
    preserved_cursor_index = first_unpinned_index + viewport_rows - 2
    preserved_cursor = divided[preserved_cursor_index]
    h.ipc(["sidebar-select", preserved_cursor["item_type"],
           str(preserved_cursor["item_id"])])
    h.key("ctrl+y", pause=0.1)
    separator_top = h.ipc(["sidebar"])
    require(separator_top.get("selected_type") ==
                preserved_cursor["item_type"] and
            separator_top.get("selected_id") == preserved_cursor["item_id"] and
            separator_top.get("scroll_offset") == separator_index,
            "sidebar Ctrl+Y did not preserve the cursor with separator at top",
            separator_top)
    h.ipc(["sidebar-focus", "sidebar"])
    after_refresh = h.ipc(["sidebar"])
    require(after_refresh.get("selected_id") == preserved_cursor["item_id"] and
            after_refresh.get("scroll_offset") == separator_index,
            "ordinary sidebar refresh re-snapped a valid scroll result",
            after_refresh)

    require(h.ipc(["status"])["active_tabid"] == active_tab,
            "sidebar Ctrl-scroll activated a row instead of only selecting it")


def test_shift_jk_uses_focused_sidebar_order_inside_folder(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url + "#shift-a"])
    h.ipc(["open-tab", h.initial_url + "#shift-b"])
    tabs = h.ipc(["tabs"])["tabs"]
    first, second = tabs[-2], tabs[-1]

    folder_reply = h.ipc(["folder-create", "0", "Shift JK container"])
    container = max(folder_reply["folders"], key=lambda item: item["id"])
    h.ipc(["tab-folder", str(first["id"]), str(container["id"])])
    h.ipc(["tab-folder", str(second["id"]), str(container["id"])])
    nested_reply = h.ipc([
        "folder-create", str(container["id"]), "Between tabs"
    ])
    nested = max(nested_reply["folders"], key=lambda item: item["id"])

    # The child folder was appended after both tabs. Move it up once so the
    # visible order is first-tab, child-folder, second-tab.
    h.ipc(["sidebar-select", "folder", str(nested["id"])])
    h.ipc(["sidebar-focus", "sidebar"])
    h.key("e", pause=0.2)
    h.ipc(["sidebar-select", "tab", str(first["id"])])
    h.ipc(["sidebar-focus", "web"])
    before = h.ipc(["status"])

    h.key("shift+j", pause=0.25)
    after_j = h.ipc(["status"])
    require(after_j.get("mode") == "SIDEBAR" and
            after_j.get("active_tabid") == before.get("active_tabid") and
            after_j.get("current_folder_id") == container["id"] and
            after_j.get("sidebar_selected_type") == "folder" and
            after_j.get("sidebar_selected_id") == nested["id"],
            "Shift+J did not follow the focused row's visual folder order",
            {"before": before, "after": after_j})

    h.key("shift+k", pause=0.25)
    after_k = h.ipc(["status"])
    require(after_k.get("active_tabid") == before.get("active_tabid") and
            after_k.get("current_folder_id") == container["id"] and
            after_k.get("sidebar_selected_type") == "tab" and
            after_k.get("sidebar_selected_id") == first["id"],
            "Shift+K did not return to the focused row above", after_k)

    h.ipc(["folder-delete", str(container["id"]), "recursive"])


def test_sidebar_d_focuses_next_visible_tab(h: Harness) -> None:
    for suffix in ("pinned", "above", "target", "below"):
        h.ipc(["open-tab", h.initial_url + "#delete-" + suffix])
    tabs = h.ipc(["tabs"])["tabs"]
    pinned, above, target, below = tabs[-4:]
    folder_reply = h.ipc(["folder-create", "0", "Delete focus container"])
    container = max(folder_reply["folders"], key=lambda item: item["id"])
    for tab in (pinned, above, target, below):
        h.ipc(["tab-folder", str(tab["id"]), str(container["id"])])
    h.ipc(["tab-pin", str(pinned["id"]), "on"])
    h.ipc(["sidebar-select", "tab", str(target["id"])])
    h.ipc(["sidebar-focus", "sidebar"])

    # A tab does not need the recursive-folder confirmation. Deleting a middle
    # row must keep the cursor at that visual position by selecting the row that
    # was below it, even though another unpinned row also survives above it.
    count_before = len(h.ipc(["tabs"])["tabs"])
    h.key("d", pause=0.25)
    after_d = h.ipc(["status"])
    remaining_ids = {tab["id"] for tab in h.ipc(["tabs"])["tabs"]}
    require(len(remaining_ids) == count_before - 1 and
            target["id"] not in remaining_ids and
            after_d.get("current_folder_id") == container["id"] and
            after_d.get("sidebar_selected_type") == "tab" and
            after_d.get("sidebar_selected_id") == below["id"],
            "sidebar d did not focus the next visible tab",
            after_d)

    # The selected next row is the active page. When it is the section's final
    # row, deletion should fall back upward within that section instead of
    # crossing the pinned divider.
    h.key("d", pause=0.25)
    after_active_d = h.ipc(["status"])
    require(after_active_d.get("current_folder_id") == container["id"] and
            after_active_d.get("active_tabid") == above["id"] and
            after_active_d.get("sidebar_selected_type") == "tab" and
            after_active_d.get("sidebar_selected_id") == above["id"],
            "deleting the final row did not use the same-section fallback",
            after_active_d)

    h.ipc(["folder-delete", str(container["id"]), "recursive"])


def test_sidebar_p_toggles_folder_pin(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url])
    tabs = h.ipc(["tabs"])["tabs"]
    folder_reply = h.ipc(["folder-create", "0", "Pinned folder"])
    folder = max(folder_reply["folders"], key=lambda item: item["id"])
    require(folder["id"] == tabs[0]["id"],
            "fixture did not create colliding tab/folder IDs",
            {"folder": folder, "tab": tabs[0]})

    # Pin the colliding tab first so folder p must append to the shared pinned
    # section without confusing equal numeric tab/folder IDs.
    h.ipc(["tab-pin", str(tabs[0]["id"]), "on"])
    h.ipc(["sidebar-select", "folder", str(folder["id"])])
    h.ipc(["sidebar-focus", "sidebar"])
    h.key("p", pause=0.25)

    pinned_folder = next(
        item for item in h.ipc(["folders"])["folders"]
        if item["id"] == folder["id"]
    )
    sidebar = h.ipc(["sidebar"])
    pinned_entries = [
        (row["item_type"], row["item_id"])
        for row in sidebar["rows"]
        if row["kind"] == "entry" and row.get("pinned")
    ]
    row_kinds = [row["kind"] for row in sidebar["rows"]]
    require(pinned_folder["pinned"],
            "sidebar p did not pin the selected folder", pinned_folder)
    require(pinned_entries == [("tab", tabs[0]["id"]),
                               ("folder", folder["id"])],
            "folder did not append to the shared pinned section", sidebar)
    require(row_kinds.count("section_label") == 1 and
            row_kinds.count("separator") == 1,
            "shared pinned section label/separator was not canonical", sidebar)

    h.key("p", pause=0.25)
    unpinned_folder = next(
        item for item in h.ipc(["folders"])["folders"]
        if item["id"] == folder["id"]
    )
    require(not unpinned_folder["pinned"],
            "second sidebar p did not unpin the selected folder",
            unpinned_folder)


def test_sidebar_keybinds_do_not_type(h: Harness) -> None:
    h.reset(focus_input=True)
    h.focus_sidebar()
    h.key("j", "k", "m", pause=0.35)
    snap = h.snapshot()
    require(snap["value"] == "", "sidebar keybindings leaked into focused input", snap)
    require(not any(e.get("type") == "input" for e in snap["events"]),
            "sidebar keybindings generated input events", snap)


def test_sidebar_i_focuses_webview_insert_without_typing(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=True)
    h.focus_sidebar()
    before = h.ipc(["status"])
    require(before.get("mode") == "SIDEBAR",
            "could not focus sidebar before testing sidebar i", before)

    h.clear()
    h.key("i", pause=0.25)
    status = h.wait_for_mode("INSERT")
    after_i = h.snapshot()
    require(after_i["value"] == "",
            "sidebar i leaked into the focused input while entering insert mode",
            {"status": status, "snapshot": after_i})
    require(not any(e.get("type") == "input" for e in after_i["events"]),
            "sidebar i generated an input event while entering insert mode",
            {"status": status, "snapshot": after_i})

    h.key("x", pause=0.2)
    after_x = h.snapshot()
    require(after_x["value"] == "x",
            "sidebar i did not focus the webview in insert mode for following text",
            {"status": status, "snapshot": after_x})


def test_ctrl_jk_cycle_focus_not_hints(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("ctrl+j", "ctrl+j", pause=0.25)
    h.key("j", pause=0.25)
    after_ctrl_j = h.snapshot()
    require(after_ctrl_j["scrollY"] > 0,
            "Ctrl+J no longer cycled focus back to the webview", after_ctrl_j)
    require(not any(e.get("type") == "contextmenu" for e in after_ctrl_j["events"]),
            "Ctrl+J still started right-click hints", after_ctrl_j)

    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("ctrl+k", "ctrl+k", pause=0.25)
    h.key("j", pause=0.25)
    after_ctrl_k = h.snapshot()
    require(after_ctrl_k["scrollY"] > 0,
            "Ctrl+K no longer cycled focus back to the webview", after_ctrl_k)
    require(not any(e.get("type") in ("mouseover", "mousemove")
                    for e in after_ctrl_k["events"]),
            "Ctrl+K still started hover hints", after_ctrl_k)


def test_ctrl_lh_start_right_click_and_hover_hints(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=False)
    h.clear()
    h.key("ctrl+l", pause=0.25)
    h.key("a", pause=0.5)
    right_click = h.snapshot()
    require(any(e.get("type") == "contextmenu" for e in right_click["events"]),
            "Ctrl+L did not start right-click hints", right_click)

    reset_to_website_mode(h, focus_input=False)
    h.clear()
    h.key("ctrl+h", pause=0.25)
    h.key("a", pause=0.5)
    hover = h.snapshot()
    require(any(e.get("type") in ("mouseover", "mousemove")
                for e in hover["events"]),
            "Ctrl+H did not start hover hints", hover)


def test_hints_work_before_full_page_load_and_survive_navigation(binary: Path) -> None:
    with SlowReloadHttpServer() as server:
        h = Harness(binary, initial_url=server.url)
        try:
            with h:
                reset_to_website_mode(h, focus_input=False)
                h.clear()
                h.key("r", pause=0.05)
                h.key("f", pause=0.1)

                pending_status = h.ipc(["status"])
                require(pending_status.get("mode") == "HINT",
                        "hints did not start while replacement navigation was pending",
                        pending_status)

                # Wait for the replacement document's DOM, but not its deliberately
                # slow image. This is the normal real-world interval where useful
                # controls are painted while the browser still reports IsLoading().
                deadline = time.time() + 8
                last = None
                while time.time() < deadline:
                    try:
                        last = h.js(
                            "JSON.stringify({generation: window.reloadGeneration || 0, "
                            "ready: document.readyState})",
                            timeout=2,
                        )
                        if (last.get("generation", 0) >= 2 and
                                last.get("ready") != "complete"):
                            break
                    except Exception as exc:  # The renderer can be between documents.
                        last = repr(exc)
                    time.sleep(0.05)
                else:
                    raise AssertionError(
                        "replacement DOM did not become usable before full load; "
                        f"last={last!r}")

                tabs = h.ipc(["tabs"]).get("tabs", [])
                active_tab = next((tab for tab in tabs if tab.get("active")), None)
                require(active_tab and active_tab.get("loading") is True,
                        "test page was not still loading before the hint command",
                        {"document": last, "active_tab": active_tab})
                committed_status = h.ipc(["status"])
                require(committed_status.get("mode") in ("WEBSITE", "NORMAL"),
                        "document replacement did not clear old hint mode",
                        committed_status)

                h.key("f", pause=0.2)
                hint_status = h.ipc(["status"])
                require(hint_status.get("mode") == "HINT",
                        "hints did not start on the partially loaded document",
                        {"status": hint_status, "active_tab": active_tab})

                # body is label a and the button is label s on this fixture.
                h.key("s", pause=0.3)
                clicked = h.snapshot()
                require(any(e.get("type") == "click" and e.get("target") == "button"
                            for e in clicked["events"]),
                        "partially loaded page hint did not activate its button",
                        clicked)

                deadline = time.time() + 8
                while time.time() < deadline:
                    last = h.js(
                        "JSON.stringify({generation: window.reloadGeneration || 0, "
                        "ready: document.readyState})",
                        timeout=2,
                    )
                    if last.get("generation", 0) >= 2 and last.get("ready") == "complete":
                        break
                    time.sleep(0.05)
                else:
                    raise AssertionError(
                        f"reload did not complete after using hints; last={last!r}")

                status = h.ipc(["status"])
                require(status.get("mode") in ("WEBSITE", "NORMAL"),
                        "using hints during load left browser stuck in hint mode", status)
                h.key("j", pause=0.25)
                snap = h.snapshot()
                require(snap["scrollY"] > 0,
                        "normal page keybindings did not recover after loading hints",
                        {"status": status, "snapshot": snap})
        finally:
            h.cleanup()


test_hints_work_before_full_page_load_and_survive_navigation.owns_harness = True


def test_cold_start_launch_url_restores_saved_tabs_at_bottom(binary: Path) -> None:
    h = Harness(binary)
    try:
        saved_one = h.profile / "saved-one.html"
        saved_two = h.profile / "saved-two.html"
        saved_one.write_text("<!doctype html><title>saved one</title>")
        saved_two.write_text("<!doctype html><title>saved two</title>")
        saved_urls = [saved_one.as_uri(), saved_two.as_uri()]
        opened_url = h.initial_url
        (h.profile / "state").write_text(
            "showmode=on\n"
            "showfps=off\n"
            "shader=on\n"
            "active=0\n"
            + "".join(f"tab={url}\n" for url in saved_urls)
        )

        with h:
            tabs = h.ipc(["tabs"])
            urls = [tab.get("url") for tab in tabs.get("tabs", [])]
            require(urls == [*saved_urls, opened_url],
                    "cold-start launch URL did not preserve saved tabs and append at bottom",
                    tabs)
            require(tabs.get("active_index") == 2,
                    "cold-start launch URL was not focused at the bottom", tabs)
    finally:
        h.cleanup()


test_cold_start_launch_url_restores_saved_tabs_at_bottom.owns_harness = True


def test_youtube_insert_hjkl_respects_focused_text_input(binary: Path) -> None:
    with StaticHttpsServer(YOUTUBE_TEST_HTML) as server:
        require(server.url is not None, "test https server did not start")
        with Harness(
            binary,
            initial_url=server.url,
            html=YOUTUBE_TEST_HTML,
            extra_browser_args=[
                "--host-resolver-rules=MAP not.youtube.com 127.0.0.1",
                "--ignore-certificate-errors",
            ],
        ) as h:
            status = h.ipc(["status"])
            require("not.youtube.com" in status.get("url", ""),
                    "youtube shortcut regression page did not load with youtube host",
                    status)

            h.reset(focus_input=True)
            h.key("i", pause=0.2)
            h.clear()
            time.sleep(0.2)
            for key in ("h", "j", "k", "l"):
                h.key(key, pause=0.15)
            focused = h.snapshot()
            require(focused["active"] == "input",
                    "youtube shortcut text-input case lost input focus", focused)
            require(focused["value"] == "hjkl",
                    "YouTube insert-mode h/j/k/l shortcuts captured text input",
                    focused)
            require(focused["shortcutLog"] == [],
                    "YouTube insert-mode h/j/k/l shortcuts ran while text input was focused",
                    focused)

            h.reset(focus_input=False)
            h.clear()
            h.key("j", "k", pause=0.45)
            body = h.snapshot()
            require(body["active"] == "BODY",
                    "youtube shortcut body-focus case did not focus the body", body)
            require(any(str(entry).startswith("volume:")
                        for entry in body["shortcutLog"]),
                    "YouTube insert-mode j/k shortcuts no longer run outside text input",
                    body)


test_youtube_insert_hjkl_respects_focused_text_input.owns_harness = True


def test_youtube_playback_requires_lone_space(binary: Path) -> None:
    with StaticHttpsServer(YOUTUBE_TEST_HTML) as server:
        require(server.url is not None, "test https server did not start")
        with Harness(
            binary,
            initial_url=server.url,
            html=YOUTUBE_TEST_HTML,
            extra_browser_args=[
                "--host-resolver-rules=MAP not.youtube.com 127.0.0.1",
                "--ignore-certificate-errors",
            ],
        ) as h:
            reset_to_website_mode(h, focus_input=False)
            h.clear()
            h.key("space", pause=0.3)
            plain_space = h.snapshot()
            require(plain_space["shortcutLog"] == ["pause"],
                    "lone YouTube Space did not toggle playback exactly once",
                    plain_space)

            reset_to_website_mode(h, focus_input=False)
            h.clear()
            h.key("shift+space", pause=0.3)
            shifted_space = h.snapshot()
            require(shifted_space["shortcutLog"] == [],
                    "Shift+Space triggered YouTube playback", shifted_space)
            require(not any(event.get("type") == "keyup" and
                            event.get("key") in (" ", "Spacebar")
                            for event in shifted_space["events"]),
                    "Shift+Space release leaked to the YouTube page",
                    shifted_space)

            reset_to_website_mode(h, focus_input=False)
            h.clear()
            h.key("ctrl+space", pause=0.3)
            control_space = h.snapshot()
            require(control_space["shortcutLog"] == [],
                    "Ctrl+Space hints triggered YouTube playback", control_space)
            require(not any(event.get("type") == "keyup" and
                            event.get("key") in (" ", "Spacebar")
                            for event in control_space["events"]),
                    "Ctrl+Space release leaked to the YouTube page",
                    control_space)
            require(h.ipc(["status"]).get("mode") == "HINT",
                    "Ctrl+Space did not enter hint mode in playback regression",
                    control_space)


test_youtube_playback_requires_lone_space.owns_harness = True


def test_youtube_cinematics_hidden_by_shader(binary: Path) -> None:
    with StaticHttpsServer(YOUTUBE_CINEMATICS_TEST_HTML, host="www.youtube.com") as server:
        require(server.url is not None, "youtube cinematics test server did not start")

        def snapshot_for_shader(shader: str) -> dict:
            h = Harness(
                binary,
                initial_url=server.url,
                html=YOUTUBE_CINEMATICS_TEST_HTML,
                extra_browser_args=[
                    "--host-resolver-rules=MAP www.youtube.com 127.0.0.1",
                    "--ignore-certificate-errors",
                    f"--vimbrowser-shader={shader}",
                ],
            )
            (h.profile / "state").write_text(
                "showmode=on\n"
                "showfps=off\n"
                f"shader={shader}\n"
                "active=0\n"
            )
            with h:
                status = h.ipc(["status"])
                require("www.youtube.com" in status.get("url", ""),
                        "youtube cinematics regression page did not load with youtube host",
                        status)
                return h.snapshot()

        shader_on = snapshot_for_shader("on")
        require(shader_on["root"]["visibility"] == "hidden" and
                shader_on["root"]["opacity"] == "0" and
                shader_on["canvas"]["visibility"] == "hidden" and
                shader_on["canvas"]["opacity"] == "0",
                "YouTube #cinematics ambient canvas was not suppressed with shader on",
                shader_on)

        shader_off = snapshot_for_shader("off")
        require(shader_off["root"]["visibility"] == "visible" and
                shader_off["root"]["opacity"] == "1" and
                shader_off["canvas"]["visibility"] == "visible" and
                shader_off["canvas"]["opacity"] == "1",
                "YouTube #cinematics ambient canvas was suppressed with shader off",
                shader_off)


test_youtube_cinematics_hidden_by_shader.owns_harness = True


def test_proprietary_media_codecs_advertised(h: Harness) -> None:
    support = h.js(r'''JSON.stringify((() => {
      const video = document.createElement('video');
      const audio = document.createElement('audio');
      return {
        h264AacMp4: video.canPlayType('video/mp4; codecs="avc1.42E01E, mp4a.40.2"'),
        h264Mp4: video.canPlayType('video/mp4; codecs="avc1.42E01E"'),
        aacMp4: audio.canPlayType('audio/mp4; codecs="mp4a.40.2"'),
        mp3: audio.canPlayType('audio/mpeg'),
        mseH264AacMp4: window.MediaSource
          ? MediaSource.isTypeSupported('video/mp4; codecs="avc1.42E01E, mp4a.40.2"')
          : false
      };
    })())''')
    for key in ("h264AacMp4", "h264Mp4", "aacMp4", "mp3"):
        require(support.get(key) in ("maybe", "probably"),
                f"Chromium media stack does not advertise {key} support", support)
    require(support.get("mseH264AacMp4") is True,
            "Chromium MSE media stack does not advertise H.264/AAC MP4 support",
            support)


def test_h264_aac_mp4_video_actually_plays(binary: Path) -> None:
    with StaticHttpMediaServer() as server:
        require(server.url is not None, "media playback server did not start")
        with Harness(
            binary,
            initial_url=server.url,
            html=MP4_PLAYBACK_TEST_HTML,
        ) as h:
            initial = h.snapshot()
            require(initial.get("canPlay") in ("maybe", "probably") and
                    initial.get("mseH264AacMp4") is True,
                    "H.264/AAC MP4 playback fixture is not advertised as supported",
                    initial)

            h.js("window.startPlayback()")
            deadline = time.time() + 5
            last = None
            while time.time() < deadline:
                last = h.snapshot()
                if (not last.get("error") and not last.get("paused") and
                        float(last.get("currentTime") or 0) > 0.05):
                    return
                time.sleep(0.1)
            require(False, "H.264/AAC MP4 video did not start playing", last)


test_h264_aac_mp4_video_actually_plays.owns_harness = True


def test_escape_and_sidebar_space_passthrough(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("Escape", pause=0.2)
    web = h.snapshot()
    require("Escape" in web["keys"], "website-mode Escape did not pass through", web)
    require(web["active"] != "input", "website-mode Escape did not blur focused input", web)

    reset_to_website_mode(h, focus_input=True)
    h.focus_sidebar()
    h.key("Escape", pause=0.2)
    h.key("space", pause=0.35)
    sidebar = h.snapshot()
    require("Escape" in sidebar["keys"], "sidebar Escape did not pass through", sidebar)
    require(sidebar["active"] != "input", "sidebar Escape did not blur focused input", sidebar)
    require(" " in sidebar["keys"] or "Spacebar" in sidebar["keys"],
            "sidebar Space did not pass through", sidebar)
    require(len(sidebar["keys"]) < 10, "forwarded sidebar keys recursively re-entered shell", sidebar)


TESTS = [
    test_mode_entry_i_does_not_leak_and_insert_types,
    test_text_input_focus_auto_enters_insert_mode,
    test_hint_to_text_input_auto_enters_insert_mode,
    test_first_i_and_shift_i_type_in_insert_mode,
    test_shifted_jk_type_in_insert_mode,
    test_insert_escape_exits_without_passthrough,
    test_normal_escape_returns_to_website_mode,
    test_website_keybinds_do_not_type,
    test_sidebar_jk_moves_selection_and_enter_activates,
    test_sidebar_gg_and_G_jump_to_visible_ends,
    test_sidebar_super_is_a_noop,
    test_sidebar_t_opens_tab_focus_command,
    test_sidebar_ctrl_scroll_keys_are_cursor_aware,
    test_sidebar_p_toggles_folder_pin,
    test_shift_jk_uses_focused_sidebar_order_inside_folder,
    test_sidebar_d_focuses_next_visible_tab,
    test_sidebar_keybinds_do_not_type,
    test_sidebar_i_focuses_webview_insert_without_typing,
    test_ctrl_jk_cycle_focus_not_hints,
    test_ctrl_lh_start_right_click_and_hover_hints,
    test_hints_work_before_full_page_load_and_survive_navigation,
    test_cold_start_launch_url_restores_saved_tabs_at_bottom,
    test_youtube_insert_hjkl_respects_focused_text_input,
    test_youtube_playback_requires_lone_space,
    test_youtube_cinematics_hidden_by_shader,
    test_proprietary_media_codecs_advertised,
    test_h264_aac_mp4_video_actually_plays,
    test_escape_and_sidebar_space_passthrough,
]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, default=DEFAULT_BINARY)
    args = parser.parse_args()

    print("vimbrowser key regression tests")
    print(f"binary: {args.binary}")
    for test in TESTS:
        name = test.__name__.replace("test_", "")
        print(f"[RUN] {name}")
        if getattr(test, "owns_harness", False):
            test(args.binary)
        else:
            with Harness(args.binary) as h:
                test(h)
        print(f"[PASS] {name}")
    print("CHECK: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print("CHECK: FAIL", file=sys.stderr)
        print(textwrap.indent(str(exc), "  "), file=sys.stderr)
        raise
