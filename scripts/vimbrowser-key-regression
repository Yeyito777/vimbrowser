def test_sidebar_jk_moves_selection_and_enter_activates(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url])
    h.ipc(["open-tab", h.initial_url])
    tabs = h.ipc(["tabs"])["tabs"]
    h.ipc(["tab-focus", str(tabs[0]["id"])])
    h.reset(focus_input=False)
    h.focus_sidebar()
    before = h.ipc(["status"])
    require(before.get("mode") == "SIDEBAR" and before.get("active_index") == 0,
            "could not focus sidebar with first tab selected", before)

    h.key("j", pause=0.25)
    after_j = h.ipc(["status"])
    require(after_j.get("active_index") == 0 and
            after_j.get("sidebar_selected_type") == "tab" and
            after_j.get("sidebar_selected_id") == tabs[1]["id"],
            "sidebar j did not move selection down without activating", after_j)

    h.key("Return", pause=0.25)
    after_enter = h.ipc(["status"])
    require(after_enter.get("active_index") == 1,
            "sidebar Enter did not activate the selected tab", after_enter)

    h.key("k", pause=0.25)
    after_k = h.ipc(["status"])
    require(after_k.get("active_index") == 1 and
            after_k.get("sidebar_selected_id") == tabs[0]["id"],
            "sidebar k did not move selection up without activating", after_k)


def test_sidebar_gg_and_G_jump_to_visible_ends(h: Harness) -> None:
    h.ipc(["open-tab", h.initial_url])
    h.ipc(["open-tab", h.initial_url])
    tabs = h.ipc(["tabs"])["tabs"]
    h.ipc(["tab-focus", str(tabs[1]["id"])])
    h.reset(focus_input=False)
    h.focus_sidebar()
