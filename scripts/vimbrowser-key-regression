def test_hints_work_before_full_page_load_and_survive_navigation(binary: Path) -> None:
    with SlowReloadHttpServer() as server:
        h = Harness(binary, initial_url=server.url)
        try:
            with h:
                reset_to_website_mode(h, focus_input=False)
                h.clear()
                h.key("r", pause=0.05)
                h.key("f", pause=0.1)

                pending_status = h.ipc(["status"])
                require(pending_status.get("mode") == "HINT",
                        "hints did not start while replacement navigation was pending",
                        pending_status)

                # Wait for the replacement document's DOM, but not its deliberately
                # slow image. This is the normal real-world interval where useful
                # controls are painted while the browser still reports IsLoading().
                deadline = time.time() + 8
                last = None
                while time.time() < deadline:
                    try:
                        last = h.js(
                            "JSON.stringify({generation: window.reloadGeneration || 0, "
                            "ready: document.readyState})",
                            timeout=2,
                        )
                        if (last.get("generation", 0) >= 2 and
                                last.get("ready") != "complete"):
                            break
                    except Exception as exc:  # The renderer can be between documents.
                        last = repr(exc)
                    time.sleep(0.05)
                else:
                    raise AssertionError(
                        "replacement DOM did not become usable before full load; "
                        f"last={last!r}")

                tabs = h.ipc(["tabs"]).get("tabs", [])
                active_tab = next((tab for tab in tabs if tab.get("active")), None)
                require(active_tab and active_tab.get("loading") is True,
                        "test page was not still loading before the hint command",
                        {"document": last, "active_tab": active_tab})
                committed_status = h.ipc(["status"])
                require(committed_status.get("mode") in ("WEBSITE", "NORMAL"),
                        "document replacement did not clear old hint mode",
                        committed_status)

                h.key("f", pause=0.2)
                hint_status = h.ipc(["status"])
                require(hint_status.get("mode") == "HINT",
                        "hints did not start on the partially loaded document",
                        {"status": hint_status, "active_tab": active_tab})

                # body is label a and the button is label s on this fixture.
                h.key("s", pause=0.3)
                clicked = h.snapshot()
                require(any(e.get("type") == "click" and e.get("target") == "button"
                            for e in clicked["events"]),
                        "partially loaded page hint did not activate its button",
                        clicked)

                deadline = time.time() + 8
                while time.time() < deadline:
                    last = h.js(
                        "JSON.stringify({generation: window.reloadGeneration || 0, "
                        "ready: document.readyState})",
                        timeout=2,
                    )
                    if last.get("generation", 0) >= 2 and last.get("ready") == "complete":
                        break
                    time.sleep(0.05)
                else:
                    raise AssertionError(
                        f"reload did not complete after using hints; last={last!r}")

                status = h.ipc(["status"])
                require(status.get("mode") in ("WEBSITE", "NORMAL"),
                        "using hints during load left browser stuck in hint mode", status)
                h.key("j", pause=0.25)
                snap = h.snapshot()
                require(snap["scrollY"] > 0,
                        "normal page keybindings did not recover after loading hints",
                        {"status": status, "snapshot": snap})
        finally:
            h.cleanup()


test_hints_work_before_full_page_load_and_survive_navigation.owns_harness = True


def test_cold_start_launch_url_restores_saved_tabs_at_bottom(binary: Path) -> None:
    h = Harness(binary)
    try:
        saved_one = h.profile / "saved-one.html"
        saved_two = h.profile / "saved-two.html"
        saved_one.write_text("<!doctype html><title>saved one</title>")
        saved_two.write_text("<!doctype html><title>saved two</title>")
        saved_urls = [saved_one.as_uri(), saved_two.as_uri()]
        opened_url = h.initial_url
        (h.profile / "state").write_text(
            "showmode=on\n"
            "showfps=off\n"
            "shader=on\n"
            "active=0\n"
            + "".join(f"tab={url}\n" for url in saved_urls)
        )

        with h:
            tabs = h.ipc(["tabs"])
            urls = [tab.get("url") for tab in tabs.get("tabs", [])]
            require(urls == [*saved_urls, opened_url],
                    "cold-start launch URL did not preserve saved tabs and append at bottom",
                    tabs)
            require(tabs.get("active_index") == 2,
                    "cold-start launch URL was not focused at the bottom", tabs)
    finally:
        h.cleanup()


test_cold_start_launch_url_restores_saved_tabs_at_bottom.owns_harness = True


def test_youtube_insert_hjkl_respects_focused_text_input(binary: Path) -> None:
    with StaticHttpsServer(YOUTUBE_TEST_HTML) as server:
        require(server.url is not None, "test https server did not start")
        with Harness(
            binary,
            initial_url=server.url,
            html=YOUTUBE_TEST_HTML,
            extra_browser_args=[
                "--host-resolver-rules=MAP not.youtube.com 127.0.0.1",
                "--ignore-certificate-errors",
            ],
        ) as h:
            status = h.ipc(["status"])
            require("not.youtube.com" in status.get("url", ""),
                    "youtube shortcut regression page did not load with youtube host",
                    status)

            h.reset(focus_input=True)
            h.key("i", pause=0.2)
            h.clear()
            time.sleep(0.2)
            for key in ("h", "j", "k", "l"):
                h.key(key, pause=0.15)
            focused = h.snapshot()
            require(focused["active"] == "input",
                    "youtube shortcut text-input case lost input focus", focused)
            require(focused["value"] == "hjkl",
                    "YouTube insert-mode h/j/k/l shortcuts captured text input",
                    focused)
            require(focused["shortcutLog"] == [],
                    "YouTube insert-mode h/j/k/l shortcuts ran while text input was focused",
                    focused)

            h.reset(focus_input=False)
            h.clear()
            h.key("j", "k", pause=0.45)
            body = h.snapshot()
            require(body["active"] == "BODY",
                    "youtube shortcut body-focus case did not focus the body", body)
            require(any(str(entry).startswith("volume:")
                        for entry in body["shortcutLog"]),
                    "YouTube insert-mode j/k shortcuts no longer run outside text input",
                    body)


test_youtube_insert_hjkl_respects_focused_text_input.owns_harness = True


def test_youtube_cinematics_hidden_by_shader(binary: Path) -> None:
    with StaticHttpsServer(YOUTUBE_CINEMATICS_TEST_HTML, host="www.youtube.com") as server:
        require(server.url is not None, "youtube cinematics test server did not start")

        def snapshot_for_shader(shader: str) -> dict:
            h = Harness(
                binary,
                initial_url=server.url,
                html=YOUTUBE_CINEMATICS_TEST_HTML,
                extra_browser_args=[
                    "--host-resolver-rules=MAP www.youtube.com 127.0.0.1",
                    "--ignore-certificate-errors",
                    f"--vimbrowser-shader={shader}",
                ],
            )
            (h.profile / "state").write_text(
                "showmode=on\n"
                "showfps=off\n"
                f"shader={shader}\n"
                "active=0\n"
            )
            with h:
                status = h.ipc(["status"])
                require("www.youtube.com" in status.get("url", ""),
                        "youtube cinematics regression page did not load with youtube host",
                        status)
                return h.snapshot()

        shader_on = snapshot_for_shader("on")
        require(shader_on["root"]["visibility"] == "hidden" and
                shader_on["root"]["opacity"] == "0" and
                shader_on["canvas"]["visibility"] == "hidden" and
                shader_on["canvas"]["opacity"] == "0",
                "YouTube #cinematics ambient canvas was not suppressed with shader on",
                shader_on)

        shader_off = snapshot_for_shader("off")
        require(shader_off["root"]["visibility"] == "visible" and
                shader_off["root"]["opacity"] == "1" and
                shader_off["canvas"]["visibility"] == "visible" and
                shader_off["canvas"]["opacity"] == "1",
                "YouTube #cinematics ambient canvas was suppressed with shader off",
                shader_off)


test_youtube_cinematics_hidden_by_shader.owns_harness = True


def test_proprietary_media_codecs_advertised(h: Harness) -> None:
    support = h.js(r'''JSON.stringify((() => {
      const video = document.createElement('video');
      const audio = document.createElement('audio');
      return {
        h264AacMp4: video.canPlayType('video/mp4; codecs="avc1.42E01E, mp4a.40.2"'),
        h264Mp4: video.canPlayType('video/mp4; codecs="avc1.42E01E"'),
        aacMp4: audio.canPlayType('audio/mp4; codecs="mp4a.40.2"'),
        mp3: audio.canPlayType('audio/mpeg'),
        mseH264AacMp4: window.MediaSource
          ? MediaSource.isTypeSupported('video/mp4; codecs="avc1.42E01E, mp4a.40.2"')
          : false
      };
    })())''')
    for key in ("h264AacMp4", "h264Mp4", "aacMp4", "mp3"):
        require(support.get(key) in ("maybe", "probably"),
                f"Chromium media stack does not advertise {key} support", support)
    require(support.get("mseH264AacMp4") is True,
            "Chromium MSE media stack does not advertise H.264/AAC MP4 support",
            support)


def test_h264_aac_mp4_video_actually_plays(binary: Path) -> None:
    with StaticHttpMediaServer() as server:
        require(server.url is not None, "media playback server did not start")
        with Harness(
            binary,
            initial_url=server.url,
            html=MP4_PLAYBACK_TEST_HTML,
        ) as h:
            initial = h.snapshot()
            require(initial.get("canPlay") in ("maybe", "probably") and
                    initial.get("mseH264AacMp4") is True,
                    "H.264/AAC MP4 playback fixture is not advertised as supported",
                    initial)

            h.js("window.startPlayback()")
            deadline = time.time() + 5
            last = None
            while time.time() < deadline:
                last = h.snapshot()
                if (not last.get("error") and not last.get("paused") and
                        float(last.get("currentTime") or 0) > 0.05):
                    return
                time.sleep(0.1)
            require(False, "H.264/AAC MP4 video did not start playing", last)


test_h264_aac_mp4_video_actually_plays.owns_harness = True


def test_escape_and_sidebar_space_passthrough(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("Escape", pause=0.2)
    web = h.snapshot()
    require("Escape" in web["keys"], "website-mode Escape did not pass through", web)
    require(web["active"] != "input", "website-mode Escape did not blur focused input", web)

    reset_to_website_mode(h, focus_input=True)
    h.focus_sidebar()
    h.key("Escape", pause=0.2)
    h.key("space", pause=0.35)
    sidebar = h.snapshot()
    require("Escape" in sidebar["keys"], "sidebar Escape did not pass through", sidebar)
    require(sidebar["active"] != "input", "sidebar Escape did not blur focused input", sidebar)
    require(" " in sidebar["keys"] or "Spacebar" in sidebar["keys"],
            "sidebar Space did not pass through", sidebar)
    require(len(sidebar["keys"]) < 10, "forwarded sidebar keys recursively re-entered shell", sidebar)


TESTS = [
