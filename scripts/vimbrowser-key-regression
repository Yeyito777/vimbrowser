def test_ctrl_jk_cycle_focus_not_hints(h: Harness) -> None:
    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("ctrl+j", "ctrl+j", pause=0.25)
    h.key("j", pause=0.25)
    after_ctrl_j = h.snapshot()
    require(after_ctrl_j["scrollY"] > 0,
            "Ctrl+J no longer cycled focus back to the webview", after_ctrl_j)
    require(not any(e.get("type") == "contextmenu" for e in after_ctrl_j["events"]),
            "Ctrl+J still started right-click hints", after_ctrl_j)

    reset_to_website_mode(h, focus_input=True)
    h.clear()
    h.key("ctrl+k", "ctrl+k", pause=0.25)
    h.key("j", pause=0.25)
    after_ctrl_k = h.snapshot()
    require(after_ctrl_k["scrollY"] > 0,
            "Ctrl+K no longer cycled focus back to the webview", after_ctrl_k)
    require(not any(e.get("type") in ("mouseover", "mousemove")
                    for e in after_ctrl_k["events"]),
            "Ctrl+K still started hover hints", after_ctrl_k)


