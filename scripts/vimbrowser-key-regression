#!/usr/bin/env python3
"""Regression tests for vimbrowser shell/webview keyboard routing.

These tests run the built browser inside an xenv, drive real key events, and
observe DOM keyboard/input events through vimbrowser-ipc. They cover regressions
where shell/sidebar keybindings accidentally leak into page text fields, and the
intentional mode/passthrough exceptions around Insert, Escape, Shift+J/K, and
sidebar forwarded keys.
"""

from __future__ import annotations

import argparse
import http.server
import json
import os
from pathlib import Path
import shutil
import shlex
import ssl
import subprocess
import sys
import tempfile
import threading
import textwrap
import time

REPO = Path(__file__).resolve().parents[1]
IPC = REPO / "scripts" / "vimbrowser-ipc"
SAFE_RUN = REPO / "scripts" / "vimbrowser-safe-run"
DEFAULT_BINARY = REPO / "build-source" / "Release" / "vimbrowser"

TEST_HTML = """<!doctype html>
<meta charset=\"utf-8\">
<title>vimbrowser key regression</title>
<body tabindex=\"0\" style=\"font:20px sans-serif;padding:20px;height:3000px\">
<input id=\"input\" autofocus style=\"font:20px sans-serif;width:420px\" />
<button id=\"button\">button</button>
<div id=\"hover\" onmouseover=\"void 0\"
     style=\"display:inline-block;margin-left:20px;padding:12px;border:1px solid #888\">
  hover target
</div>
<script>
window.events=[];
window.keys=[];
for (const t of ['keydown','keypress','keyup','beforeinput','input',
                 'contextmenu','mouseover','mousemove']) {
  document.addEventListener(t, e => {
    if (t === 'contextmenu') e.preventDefault();
    window.events.push({
      type: e.type,
      key: e.key,
      code: e.code,
      target: e.target && e.target.id || e.target.tagName,
      value: document.getElementById('input').value,
      scrollY: window.scrollY
    });
    if (t === 'keydown') window.keys.push(e.key);
  }, true);
}
window.resetProbe = (focusInput = true) => {
  window.events=[];
  window.keys=[];
  window.scrollTo(0,0);
  const input = document.getElementById('input');
  input.value='';
  if (focusInput) input.focus(); else document.body.focus();
  return 'ok';
};
window.snapshotProbe = () => ({
  value: document.getElementById('input').value,
  keys: window.keys,
  events: window.events,
  scrollY: window.scrollY,
  active: document.activeElement && (document.activeElement.id || document.activeElement.tagName)
});
window.clearProbe = () => {
  window.events=[];
  window.keys=[];
  return 'ok';
};
window.addEventListener('load', () => window.resetProbe(true));
</script>
	"""

RELOAD_HINT_TEST_HTML = """<!doctype html>
<meta charset=\"utf-8\">
<title>vimbrowser reload hint regression</title>
<body tabindex=\"0\" style=\"font:20px sans-serif;padding:20px;height:3000px\">
<button id=\"button\">button</button>
<a id=\"link\" href=\"#target\">link</a>
__SLOW_RESOURCE__
<script>
window.reloadGeneration = __GEN__;
window.events=[];
window.keys=[];
for (const t of ['keydown','keypress','keyup','beforeinput','input','click']) {
  document.addEventListener(t, e => {
    window.events.push({
      type: e.type,
      key: e.key,
      code: e.code,
      target: e.target && e.target.id || e.target.tagName,
      scrollY: window.scrollY,
      generation: window.reloadGeneration
    });
    if (t === 'keydown') window.keys.push(e.key);
  }, true);
}
window.resetProbe = () => {
  window.events=[];
  window.keys=[];
  window.scrollTo(0,0);
  document.body.focus();
  return 'ok';
};
window.snapshotProbe = () => ({
  generation: window.reloadGeneration,
  keys: window.keys,
  events: window.events,
  scrollY: window.scrollY,
  active: document.activeElement && (document.activeElement.id || document.activeElement.tagName)
});
window.clearProbe = () => {
  window.events=[];
  window.keys=[];
  return 'ok';
};
window.addEventListener('load', () => window.resetProbe());
</script>
"""

